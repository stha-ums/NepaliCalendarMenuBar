default_platform(:mac)

platform :mac do
  before_all do
    load_xcconfig_secrets("../Secrets.xcconfig")
  end

  desc "Run tests"
  lane :test do
    run_tests(scheme: "BS Calendar (Bikram Sambat)")
  end

  desc "Build for GitHub Release (Notarized)"
  lane :build_github do
    # Get version from Git tag
    version = sh("git describe --tags --abbrev=0").strip.gsub('v', '')
    
    # Get build number from commit count
    build_number = sh("git rev-list --count HEAD").strip

    # Fetch certificates (read-only)
    match(
      type: "developer_id",
      readonly: true,
      keychain_name: ENV["CI"] ? "temp.keychain" : "login.keychain",
      keychain_password: ENV["CI"] ? "actions" : ""
    )

    # Update code signing settings
    update_code_signing_settings(
      path: "NepaliDateMacMenuBar.xcodeproj",
      use_automatic_signing: false
    )
    
    # Build and Archive with version injection
    gym(
      scheme: "BS Calendar (Bikram Sambat)",
      export_method: "developer-id",
      export_options: "./ExportOptions_DevID.plist",
      output_directory: "./output",
      output_name: "BS Calendar (Bikram Sambat)",
      codesigning_identity: "Developer ID Application",
      xcargs: "ARCHS='arm64 x86_64' ONLY_ACTIVE_ARCH=NO MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} OTHER_CODE_SIGN_FLAGS='--timestamp' OTHER_SWIFT_FLAGS='-D SPARKLE' DEVELOPMENT_TEAM=4DRNCBN798 CODE_SIGN_STYLE=Manual",
      verbose: true
    )

    # Notarize using App Store Connect API
    notarize(
      package: "./output/BS Calendar (Bikram Sambat).app",
      bundle_id: "calendar.nepali.app",
      api_key_path: "./app_store_connect_api_key.json",
      print_log: true
    )

    # Create DMG
    sh "brew install create-dmg || true"
    dmg_source = "./dmg_source"
    sh "rm -rf #{dmg_source} && mkdir -p #{dmg_source}"
    sh "cp -R \"./output/BS Calendar (Bikram Sambat).app\" #{dmg_source}/"
    
    sh "create-dmg \
      --volname 'BS Calendar (Bikram Sambat)' \
      --window-pos 200 120 \
      --window-size 600 400 \
      --icon-size 100 \
      --icon \"BS Calendar (Bikram Sambat).app\" 175 190 \\
      --app-drop-link 425 190 \
      --no-internet-enable \
      \"./output/BS Calendar (Bikram Sambat).dmg\" \\
      '#{dmg_source}/'"
      
    # Find generate_appcast tool
    sparkle_bin = nil
    
    # 1. Check if it's already in PATH (GHA runner path)
    if system("which generate_appcast > /dev/null")
      sparkle_bin = "generate_appcast"
    # 2. Check Sparkle 2 'sparkle' CLI
    elsif system("which sparkle > /dev/null")
      sparkle_bin = "sparkle generate-appcast"
    # 3. Try to find in Caskroom (robust fallback for local machines)
    else
      caskroom_path = `brew --prefix --caskroom 2>/dev/null`.strip
      caskroom_path = "/opt/homebrew/Caskroom" if caskroom_path.empty?
      
      matches = Dir.glob("#{caskroom_path}/sparkle/*/bin/generate_appcast")
      sparkle_bin = matches.last if matches.any?
    end

    if sparkle_bin
      # Using absolute path for output to be safe in CI
      output_abs_path = File.expand_path('./output/')
      
      # Clean up duplicate zip files that cause sparkle to fail
      zip_file = File.join(output_abs_path, "BS Calendar (Bikram Sambat).app.zip")
      if File.exist?(zip_file)
        UI.message("Removing duplicate zip file: #{zip_file}")
        File.delete(zip_file)
      end

      sh "#{sparkle_bin} \"#{output_abs_path}\""
    else
      UI.error("Could not find Sparkle's appcast generation tool. Skipping appcast generation.")
    end

    # Upload dSYMs and source context to Sentry
    sentry_debug_files_upload(
      auth_token: ENV["SENTRY_AUTH_TOKEN"],
      org_slug: ENV["SENTRY_ORG"],
      project_slug: ENV["SENTRY_PROJECT"],
      include_sources: true
    )

    # Reset to automatic code signing for local development
    update_code_signing_settings(
      path: "NepaliDateMacMenuBar.xcodeproj",
      use_automatic_signing: true
    )
  end

  desc "Upload Metadata Only"
  lane :upload_metadata do
    # Fetch certificates (read-only)
    match(type: "appstore", readonly: true)

    deliver(
      force: true, # Skip HTML report verification
      skip_binary_upload: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      platform: "osx"
    )
  end

  desc "Release to App Store"
  lane :release_appstore do
    # Get version from Git tag
    version = sh("git describe --tags --abbrev=0").strip.gsub('v', '')
    
    # Fetch certificates (read-only)
    match(
      type: "appstore",
      readonly: true,
      additional_cert_types: ["mac_installer_distribution"],
      api_key_path: "./app_store_connect_api_key.json",
      keychain_name: ENV["CI"] ? "temp.keychain" : "login.keychain",
      keychain_password: ENV["CI"] ? "actions" : ""
    )

    # Build and Archive with version injection
    gym(
      scheme: "BS Calendar (Bikram Sambat)",
      export_method: "app-store",
      export_options: "./ExportOptions_AppStore.plist",
      output_directory: "./output",
      output_name: "BS Calendar (Bikram Sambat)",
      xcargs: "ARCHS='arm64 x86_64' ONLY_ACTIVE_ARCH=NO MARKETING_VERSION=#{version}"
    )
    
    # Upload dSYMs and source context to Sentry
    sentry_debug_files_upload(
      auth_token: ENV["SENTRY_AUTH_TOKEN"],
      org_slug: ENV["SENTRY_ORG"],
      project_slug: ENV["SENTRY_PROJECT"],
      include_sources: true
    )

    # Upload to App Store
    deliver(
      force: true, # Skip HTML report verification
      pkg: "./output/BS Calendar (Bikram Sambat).pkg",
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      platform: "osx",
      api_key_path: "./app_store_connect_api_key.json",
      precheck_include_in_app_purchases: false 
    )
  end

  desc "Release to TestFlight"
  lane :release_testflight do
    # Get version from Git tag
    version = sh("git describe --tags --abbrev=0").strip.gsub('v', '')
    
    # Fetch certificates (read-only)
    match(
      type: "appstore",
      readonly: true,
      additional_cert_types: ["mac_installer_distribution"],
      api_key_path: "./app_store_connect_api_key.json",
      keychain_name: ENV["CI"] ? "temp.keychain" : "login.keychain",
      keychain_password: ENV["CI"] ? "actions" : ""
    )

    # Get the latest build number from App Store Connect for this version
    latest_build = latest_testflight_build_number(
      app_identifier: "calendar.nepali.app",
      api_key_path: "./app_store_connect_api_key.json",
      platform: "osx"
    )
    
    # Set build number to latest + 1
    increment_build_number(
      xcodeproj: "NepaliDateMacMenuBar.xcodeproj",
      build_number: latest_build + 1
    )

    # Build and Archive with version injection
    gym(
      scheme: "BS Calendar (Bikram Sambat)",
      export_method: "app-store",
      export_options: "./ExportOptions_AppStore.plist",
      output_directory: "./output",
      output_name: "BS Calendar (Bikram Sambat)",
      xcargs: "ARCHS='arm64 x86_64' ONLY_ACTIVE_ARCH=NO MARKETING_VERSION=#{version}"
    )

    # Upload dSYMs and source context to Sentry
    sentry_debug_files_upload(
      auth_token: ENV["SENTRY_AUTH_TOKEN"],
      org_slug: ENV["SENTRY_ORG"],
      project_slug: ENV["SENTRY_PROJECT"],
      include_sources: true
    )

    # Upload to TestFlight only (skip review submission)
    upload_to_testflight(
      pkg: "./output/BS Calendar (Bikram Sambat).pkg",
      api_key_path: "./app_store_connect_api_key.json",
      skip_submission: true,  # Don't submit for review
      skip_waiting_for_build_processing: false  # Wait for processing
    )
  end

  desc "Verify Sentry connection and dSYM upload"
  lane :verify_sentry do
    sentry_debug_files_upload(
      auth_token: ENV["SENTRY_AUTH_TOKEN"],
      org_slug: ENV["SENTRY_ORG"],
      project_slug: ENV["SENTRY_PROJECT"],
      include_sources: true
    )
  end
end

# Helper to load secrets from .xcconfig files for local development
def load_xcconfig_secrets(path)
  return unless File.exist?(path)
  UI.important("Loading secrets from #{path}")
  File.foreach(path) do |line|
    next if line.strip.empty? || line.strip.start_with?("//")
    if line.include?("=")
      key, value = line.split("=", 2).map(&:strip)
      # Only set if not already present (don't override CI env vars)
      ENV[key] ||= value
    end
  end
end
